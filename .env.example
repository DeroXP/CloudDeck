# ============================================================================
# CloudDeck Configuration
# ============================================================================
# Copy this file to `.env` in each component directory that needs it:
#   client/.env  - For the Railway web app
#   agent/.env   - For the PC agent
#   pi/.env      - For the Raspberry Pi WoL forwarder
#
# Variables relevant to each component are grouped in sections below.
# ============================================================================


# ----------------------------------------------------------------------------
# RAILWAY WEB APP (client/.env)
# ----------------------------------------------------------------------------

# Port the Express server listens on (Railway sets PORT automatically)
PORT=3000

# Public base URL of the Railway app (used to construct links and CORS)
PUBLIC_URL=http://localhost:3000

# Shared token the PC agent uses to authenticate to the Railway WebSocket
AGENT_TOKEN=change-me-to-a-long-random-string

# Where the Pi WoL forwarder lives. Leave PI_URL empty to disable wake-on-LAN.
PI_URL=http://192.168.1.50:5000
PI_SECRET_TOKEN=change-me-to-a-long-random-string

# JWT signing secret. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRY=24h
REFRESH_TOKEN_EXPIRY=30d

# Login brute-force protection
RATE_LIMIT_MAX_ATTEMPTS=10
RATE_LIMIT_WINDOW_MINUTES=15

# Optional TOTP 2FA. When true, admins are required to set up 2FA on first login.
ENABLE_2FA=false

# Where SQLite/JSON state lives. Use a Railway volume mount for persistence.
DATA_DIR=./data

# ----------------------------------------------------------------------------
# PC AGENT (agent/.env)
# ----------------------------------------------------------------------------

# WebSocket URL for the Railway app. Use wss:// in production.
RAILWAY_WS_URL=ws://localhost:3000

# Must match AGENT_TOKEN in the Railway app's .env
AGENT_TOKEN=change-me-to-a-long-random-string

# Reconnect backoff in milliseconds (min, max)
RECONNECT_MIN_MS=1000
RECONNECT_MAX_MS=30000

# Where Sunshine is reachable on this PC
SUNSHINE_URL=https://localhost:47990
SUNSHINE_USERNAME=admin
SUNSHINE_PASSWORD=
SUNSHINE_BROWSER_STREAM_URL=https://localhost:47989

# Steam local web API (default port)
STEAM_API_URL=http://localhost:27060
STEAM_USER_DATA_DIR=C:\Program Files (x86)\Steam\userdata

# Where Xbox / Microsoft Store games install
XBOX_GAMES_DIR=C:\XboxGames

# Folder watched for Steam screenshots
SCREENSHOT_DIR=

# Stats reporting interval (milliseconds)
STATS_INTERVAL_MS=2500
HEARTBEAT_INTERVAL_MS=5000

# Auto-updater
GITHUB_REPO=DeroXP/CloudDeck
AUTO_UPDATE_CHECK_INTERVAL_HOURS=24
ALLOW_MANDATORY_UPDATES=true

# When true, mute physical PC speakers while a remote session is active
MUTE_PC_SPEAKERS_ON_SESSION=true

# When true, allow remote-desktop mode (input passthrough to Windows desktop)
ENABLE_REMOTE_DESKTOP=true

# ----------------------------------------------------------------------------
# RASPBERRY PI WOL FORWARDER (pi/.env)
# ----------------------------------------------------------------------------

# Must match PI_SECRET_TOKEN in the Railway app's .env
PI_SECRET_TOKEN=change-me-to-a-long-random-string

# Port the Flask server listens on
PI_PORT=5000

# MAC address of the gaming PC to wake (uppercase, colon-separated)
PC_MAC_ADDRESS=AA:BB:CC:DD:EE:FF

# Broadcast address for the WoL packet (255.255.255.255 works on most networks).
# For some routers you'll need your subnet's actual broadcast, e.g. 192.168.1.255
WOL_BROADCAST_ADDRESS=255.255.255.255

# ----------------------------------------------------------------------------
# STREAM DEFAULTS (read by client; can be overridden per-device in the UI)
# ----------------------------------------------------------------------------
DEFAULT_RESOLUTION=1080p
DEFAULT_FPS=60
DEFAULT_BITRATE=20000
DEFAULT_AUDIO_BITRATE=256
AUDIO_SURROUND=false

# ----------------------------------------------------------------------------
# AFK DETECTION (read by client)
# ----------------------------------------------------------------------------
AFK_TIMEOUT_MINUTES=15
AFK_COUNTDOWN_SECONDS=300
INPUT_DEADZONE_THRESHOLD=0.15
